# PyInstaller spec for SimpleNotes.app. Run via packaging/build_mac.sh.
import os

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))
BUILD = os.path.join(ROOT, "build")

a = Analysis(
    [os.path.join(ROOT, "noteapp.py")],
    pathex=[ROOT],
    datas=[
        (os.path.join(ROOT, "simplenotesicon.png"), "."),  # generated by make_icon.py
        (os.path.join(ROOT, "LICENSE"), "."),              # GPL-3.0: ship the license with the app
    ],
    hiddenimports=["pygments.lexers", "pygments.styles"],
    excludes=["tkinter", "PIL", "unittest", "pydoc", "PyQt6.QtQml", "PyQt6.QtQuick",
              "PyQt6.QtNetwork", "PyQt6.QtWebEngineCore", "PyQt6.QtMultimedia"],
    noarchive=False,
)
pyz = PYZ(a.pure)
exe = EXE(
    pyz, a.scripts, [],
    exclude_binaries=True,
    name="SimpleNotes",
    console=False,
    upx=False,
)
coll = COLLECT(exe, a.binaries, a.datas, name="SimpleNotes", upx=False)
app = BUNDLE(
    coll,
    name="SimpleNotes.app",
    icon=os.path.join(BUILD, "SimpleNotes.icns"),
    bundle_identifier="local.simplenotes.app",
    version="1.1.2",
    info_plist={
        "CFBundleDisplayName": "Simple Notes",
        "CFBundleName": "Simple Notes",
        "CFBundleShortVersionString": "1.1.2",
        "NSHighResolutionCapable": True,
        "LSMinimumSystemVersion": "13.0",  # Qt 6.11's minimum; check QtCore's minos when upgrading
        "NSRequiresAquaSystemAppearance": False,
        "LSApplicationCategoryType": "public.app-category.productivity",
    },
)
